prefix=/usr/local
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libchttpx
Description: libchttpx with optional native OpenSSL TLS/HTTPS transport enabled.
Version: 1.6.1
Libs: -L${libdir} -lchttpx
Libs.private: -lssl -lcrypto -lz -lnghttp2
Requires.private: openssl
Cflags: -I${includedir}/libchttpx
